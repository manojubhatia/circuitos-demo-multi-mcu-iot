  "hardware_notes": [
    {
      "protocol": "I2C",
      "type": "pull_up",
      "message": "I2C bus requires pull-up resistors on SDA and SCL lines. Use 4.7k\u03a9 for standard mode (100kHz) or 2.2k\u03a9 for fast mode (400kHz). Many breakout boards include built-in pull-ups; only add external ones if the bus is not functional without them.",
